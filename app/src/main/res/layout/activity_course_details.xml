<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8FA"
    tools:context=".CourseDetailsActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="0dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:layout_margin="0dp"
                app:cardCornerRadius="0dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/imageView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    app:srcCompat="@drawable/course_image" />
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-20dp"
                android:layout_marginHorizontal="14dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                android:background="@android:color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvCourseTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="مقدمة إلى البرمجة"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="#222"
                        android:paddingBottom="8dp" />

                    <TextView
                        android:id="@+id/tvTeacherName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="د. محمد أحمد"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#3A3737"
                        android:paddingBottom="8dp"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:id="@+id/tvCoursePrice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="end"
                        android:text="200$"
                        android:textColor="#43A047"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:paddingBottom="6dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingBottom="6dp"
                        android:layout_marginTop="2dp">

                        <TextView
                            android:id="@+id/tvStudentCount"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="30 طالب"
                            android:gravity="center"
                            android:textSize="15sp"
                            android:textColor="#757575"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvHours"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="40 ساعة"
                            android:textSize="15sp"
                            android:textColor="#757575"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="هذا الكورس يقدم مقدمة شاملة للبرمجة الأساسية.
المواضيع تشمل:
- مفاهيم البرمجة مثل المتغيرات والحلقات والشروط الأساسية.
- هيكلة الكود.
- البرمجة الكائنية OOP.
- التعامل مع الملفات وإدارة البيانات.
- أساسيات قواعد البيانات وربطها بالتطبيقات.
- مشروع لتطبيق ما تعلمته."
                        android:textSize="16sp"
                        android:textColor="#444"
                        android:paddingBottom="8dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <View
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="20dp"
                android:background="#EEEEEE"/>
        </LinearLayout>
    </ScrollView>

    <!-- زر التسجيل دائم في الأسفل -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_gravity="bottom"
        android:background="@android:color/white"
        android:elevation="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegistrationInCourse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="30dp"
            android:layout_marginVertical="25dp"
            android:backgroundTint="#1976D2"
            android:textColor="@android:color/white"
            android:text="التسجيل في الكورس"
            android:textSize="18sp"
            app:cornerRadius="10dp"
            android:elevation="2dp"/>
    </FrameLayout>

</FrameLayout>
