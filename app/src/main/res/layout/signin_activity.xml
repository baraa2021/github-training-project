<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8FA"
    tools:context=".SignInActivity">

    <!-- الشعار -->
    <ImageView
        android:id="@+id/LogoIv"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_marginTop="70dp"
        android:src="@drawable/ic_launcher_foreground"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- اسم التطبيق -->
    <TextView
        android:id="@+id/eventHub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="#1976D2"
        android:textSize="25sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/LogoIv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- عنوان الشاشة -->
    <TextView
        android:id="@+id/signInTV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="تسجيل الدخول"
        android:textColor="#222"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/eventHub"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- مدخلات البيانات داخل CardView -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardviewall"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:layout_marginHorizontal="24dp"
        app:cardCornerRadius="15dp"
        app:cardElevation="3dp"
        app:cardUseCompatPadding="true"
        app:layout_constraintTop_toBottomOf="@id/signInTV"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="18dp"
            android:paddingHorizontal="14dp">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/TextInputLayout8"
                style="@style/TextInputLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="البريد الإلكتروني">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/emailET"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:drawableStart="@drawable/icon_email_24"
                    android:drawablePadding="15dp"
                    android:singleLine="true"
                    android:textSize="15sp"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/TextInputLayout9"
                style="@style/TextInputLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="كلمة المرور"
                android:layout_marginTop="13dp"
                app:endIconMode="password_toggle"
                app:endIconTint="#1976D2">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/passwordEt"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:drawableStart="@drawable/icon_lock_24"
                    android:drawablePadding="15dp"
                    android:inputType="textPassword"
                    android:singleLine="true"
                    android:textSize="15sp"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- سطر التذكير وكلمة المرور منسي -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="14dp">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/rememberMeSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    app:thumbTint="#1976D2"/>

                <TextView
                    android:id="@+id/rememberMeTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="تذكرني"
                    android:textColor="#555"
                    android:textSize="14sp"/>

                <Space
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>

                <TextView
                    android:id="@+id/forgetPasswordTV"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="نسيت كلمة المرور؟"
                    android:textColor="#1976D2"
                    android:textSize="14sp"
                    android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- زر الدخول -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/signInBt"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginTop="27dp"
        android:layout_marginHorizontal="54dp"
        android:text="دخول"
        android:textAllCaps="true"
        android:textSize="16sp"
        android:textColor="@android:color/white"
        android:icon="@drawable/icon_arrow_forward_24"
        android:backgroundTint="#1976D2"
        app:cornerRadius="13dp"
        app:layout_constraintTop_toBottomOf="@id/cardviewall"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/signInBt"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/DontHavaAccountTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ليس لديك حساب؟"
            android:textColor="#888"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/sign_upTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="سجل الآن"
            android:textColor="#1976D2"
            android:textStyle="bold"
            android:textSize="15sp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
