<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F8FB"
    android:scrollbars="none"
    android:paddingVertical="50dp"
    android:paddingHorizontal="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/courseImage"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/rounded_corner"
            android:elevation="2dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_launcher_foreground" />

        <!-- Course Title -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/course_title"
            android:layout_marginTop="8dp">

            <EditText
                android:id="@+id/editTitle"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@null"
                android:textColor="#222"
                android:textSize="16sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Course Description -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/course_description"
            android:layout_marginTop="8dp">

            <EditText
                android:id="@+id/edit_Description"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:background="@null"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:minLines="3"
                android:textColor="#222"
                android:textSize="16sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Course Hours -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/course_hours"
            android:layout_marginTop="8dp">

            <EditText
                android:id="@+id/editHours"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:inputType="number"
                android:textColor="#222"
                android:textSize="16sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Teacher Name -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/teacher_name"
            android:layout_marginTop="8dp">

            <EditText
                android:id="@+id/editTeacherName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:inputType="text"
                android:textColor="#222"
                android:textSize="16sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Course Price -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/course_price"
            android:layout_marginTop="8dp">

            <EditText
                android:id="@+id/editPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:inputType="numberDecimal"
                android:textColor="#222"
                android:textSize="16sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Select Category -->
        <TextView
            android:id="@+id/tvSelectCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/select_category"
            android:textColor="#949EAF"
            android:textStyle="bold"
            android:paddingHorizontal="10dp"
            android:textSize="16sp" />

        <!-- Category Row -->
        <LinearLayout
            android:id="@+id/categoryLinearLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/spinnerCategory"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_weight="1"
                android:background="@drawable/rounded_corner"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

            <Button
                android:id="@+id/btnAddCategory"
                android:layout_width="wrap_content"
                android:layout_height="45dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="#43A047"
                android:textColor="@android:color/white"
                android:text="إضافة تصنيف"
                android:textStyle="bold"
                android:layout_gravity="center_vertical" />
        </LinearLayout>

        <!-- Add Lessons Button -->
        <Button
            android:id="@+id/btnGoToLessons"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#FF7F3F"
            android:text="إضافة الدروس"
            android:textColor="@android:color/black"
            android:textStyle="bold" />

        <!-- Add Course Button -->
        <Button
            android:id="@+id/btnAddCourse"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#2155CD"
            android:text="تم"
            android:textColor="@android:color/white"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
